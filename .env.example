# =========================================================================
# Real Rails: On-Chain vs Card Settlement Intelligence (Environment Config)
# =========================================================================

# --- Frontend Configurations (Next.js) ---
# The URL pointing to the FastAPI backend API endpoints.
# If running locally, this defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend Configurations (FastAPI) ---
# Host and port details for running the FastAPI backend server (Uvicorn).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
